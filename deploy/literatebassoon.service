[Unit]
Description=Literate Bassoon agent services exchange
After=network.target

[Service]
Type=simple
User=REPLACE_HESTIA_USER
WorkingDirectory=/home/REPLACE_HESTIA_USER/web/REPLACE_DOMAIN/public_html
Environment=HOST=127.0.0.1
Environment=PORT=9003
Environment=DATA_DIR=/home/REPLACE_HESTIA_USER/web/REPLACE_DOMAIN/private/exchange-data
Environment=OPERATOR_NAME=Kestrel
ExecStart=/usr/bin/node src/server.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
