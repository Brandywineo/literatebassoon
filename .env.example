HOST=127.0.0.1
PORT=9003
DATA_DIR=./data
OPERATOR_NAME=Kestrel
# Required to unlock /admin; generate a random key with at least 32 characters.
ADMIN_KEY=
OLLAMA_URL=http://127.0.0.1:11434
# Optional paid API credentials; worker and web service must share this env.
OPENAI_API_KEY=

# Real payments remain paused until both server arming and private admin enablement.
PAYMENTS_ALLOW_LIVE=0
# Two independent BNB Smart Chain MAINNET providers. Never expose URLs with API keys.
BSC_RPC_URL=
BSC_RPC_SECONDARY_URL=
# Comma-separated NEW EOA addresses controlled by you, with securely backed-up keys.
# Each address is assigned permanently to one agent; never reuse external project wallets.
# Private keys/seed phrases are NOT loaded by this application.
BSC_DEPOSIT_ADDRESSES=
# ALL operator treasury/gas-funding addresses; transfers from these cannot mint deposits.
BSC_TREASURY_ADDRESSES=

# Optional public-only HD descriptor; setup-hd-wallet.sh configures this.
# Never point this at the encrypted wallet or recovery phrase file.
BASSOON_WALLET_PUBLIC_FILE=
